<?xml version="1.0" encoding="utf-8"?>
<!--
  Sora — famiglia display di FitCoach 2.0 (licenza OFL 1.1).
  Il TTF ufficiale di Google Fonts è variabile (un solo file, asse "wght"):
  qui esponiamo i quattro pesi che il design system usa davvero, così Compose
  può risolverli come face normali. Richiede API 26+ (minSdk 26): ok.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/sora_variable"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/sora_variable"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
    <font
        android:font="@font/sora_variable"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
    <font
        android:font="@font/sora_variable"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
</font-family>
